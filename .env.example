# ===== 服务 =====
LISTEN_ADDR=:8080
# 反向代理地址(逗号分隔);为空表示不信任任何代理头。docker compose 部署时由 compose 强制指定,无需在此配置
TRUSTED_PROXIES=127.0.0.1
# 对外回调基址(易支付回调/返回地址用),生产必须是 https://你的域名
CALLBACK_ADDRESS=http://localhost:8080
# 前端/管理台地址(支付完成跳回用),生产必须是 https://你的域名
CONSOLE_ADDRESS=http://localhost:8080

# ===== Docker 部署(docker compose 专用,本地裸跑可忽略) =====
# 域名(Caddy 据此自动申请 HTTPS 证书),只填域名不带协议,如 api.example.com
DOMAIN=
# PostgreSQL 密码(compose 里的 postgres 与应用共用)
POSTGRES_PASSWORD=

# ===== 数据库 =====
# postgres: host=127.0.0.1 user=postgres password=xxx dbname=aiform port=5432 sslmode=disable
# 留空则使用本地 sqlite 文件 aiform.db(仅开发)
DB_DSN=

# ===== 密钥 =====
JWT_SECRET=change-me-32bytes-random
# 验证码/兑换类 HMAC pepper
HASH_PEPPER=change-me-too

# ===== 管理员 =====
# 逗号分隔;这些邮箱登录后自动获得管理员角色
ADMIN_EMAILS=

# ===== SMTP =====
SMTP_SERVER=
SMTP_PORT=465
SMTP_ACCOUNT=
SMTP_FROM=
SMTP_TOKEN=
SMTP_SSL=true
SYSTEM_NAME=AI智能录入助手

# ===== 易支付 =====
EPAY_URL=
EPAY_PID=
EPAY_KEY=

# ===== AI =====
# 提示词目录(私有,不入库)。AI 上游与能力模型参数在 /admin 管理台维护,不走环境变量
PROMPTS_DIR=prompts/private
